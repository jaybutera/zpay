# Rust
/target/
Cargo.lock

# Database
*.db
*.db-*

# Environment
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Foundry (in contracts/)
contracts/cache/
contracts/out/
contracts/broadcast/

# ralph loop log
.ralph.log

# testnet deployment output (local to each deployer). The glob catches the next
# deployed.<chain>.env before someone writes one.
scripts/testnet/*.env

# standalone proof harness
scripts/proof/node_modules/
scripts/proof/attestation.json
scripts/testnet/live.intent.env.*

# Stage B live-test keystore (real private keys; never commit)
scripts/stageb/keystore/
scripts/stageb/*.key
scripts/stageb/quote.json
scripts/stageb/poll.log
scripts/stageb/live.quote.env
# Every staged live run, not just the first one named. These record one
# operator's deposit address, refund address and session id: no keys, but a
# public repo has no business carrying a person's Zcash addresses.
scripts/stageb/live.*.env

# Deploy state: addresses recorded per chain by scripts/deploy/*. No keys, but
# it names one specific deployment, so it belongs to the operator, not the repo.
scripts/deploy/state/

# Launch keystore: the real deployer/keeper/taker private keys. Never commit.
scripts/deploy/keystore/

# Configs generated from .env by scripts/deploy/03_write_config.sh. Regenerate
# them rather than committing one deployment's addresses.
config.generated.toml
config.taker.generated.toml
config.taker.toml

# Attestations carry a signature over a real payment. Not a credential, but not
# ours to publish either.
scripts/proof/attestation*.json

# Local coordinator database
zecp2p*.db
taker-fills.jsonl

# Venmo login credentials for the unattended taker. The real username, password
# and TOTP seed live in config/venmo.local.toml; only the placeholder template
# next to it is committed. Anyone holding this file can sign into the account
# and move the operator's money.
config/venmo.local.toml
config/*.local.toml
