# zecp2p environment.
#
# Copy to .env and fill it in. .env is gitignored, along with every .env.*
# variant, so a backup or a per-chain copy cannot be committed by accident.
#
#   cp .env.example .env
#   $EDITOR .env
#   scripts/deploy/00_preflight.sh
#
# DEPLOY.md walks through the whole sequence. Every address, URL, key path and
# chain id the deploy uses appears here; nothing is hardcoded in a script.
#
# The values shown for external contracts are Base mainnet's, verified on chain
# by 00_preflight.sh. Leave them alone unless you are deploying somewhere else.

# =============================================================================
# Chain and RPC
# =============================================================================

# 8453 = Base mainnet. This is the only chain the full flow works on: zk-p2p's
# payment verifier is deployed only here, and the attestation enclave signs an
# EIP-712 domain bound to it, so a proof cannot be replayed onto another chain.
CHAIN_ID=8453

# A public RPC works but is rate limited; the keeper polls every 15 seconds and
# a 429 shows up as a check that silently returns nothing. Use your own endpoint
# for anything beyond a first run.
BASE_RPC_URL=https://mainnet.base.org

# =============================================================================
# Keys
# =============================================================================
# Three separate roles. They can be the same key, but the point of splitting
# them is that the owner key can stay cold: the owner can always take the keeper
# role back, and the keeper can never change the owner.
#
# Never commit a filled-in .env. Nothing in this repo reads a key from a file
# that is not gitignored.

# Deploys the contract and becomes its owner. Needs Base ETH for gas only.
# After step 02 hands the keeper role over, this key can go back in the cold.
DEPLOYER_PRIVATE_KEY=0x...

# The coordinator's hot key. Signs createSession, processOfframp, rescue and
# withdrawFromZkp2p, so it needs its own Base ETH and it is online continuously.
# It never needs USDC: the USDC it moves belongs to the glue, not to this key.
COORDINATOR_PRIVATE_KEY=0x...

# If the keeper key lives somewhere this machine cannot read (a signer, an HSM),
# give its address here instead and leave COORDINATOR_PRIVATE_KEY unset. Step 02
# only needs the address to point the contract at it.
# COORDINATOR_ADDRESS=0x...

# Shared bearer token takers present to read the coordinator's /deposits/open.
# That endpoint is the one place a Venmo username leaves the coordinator, so it
# is authenticated: payeeDetails on chain is an opaque hash precisely so an
# observer cannot learn who to pay. The coordinator refuses to start bound to
# anything but loopback without this set. Give the same value to each taker.
# COORDINATOR_TAKER_TOKEN=

# A user's own wallet key, for the CLI. This is not an operator key: it belongs
# to whoever owns the offramp session, it signs locally, and it is never sent
# anywhere. It proves ownership to the coordinator, and with
# `zecp2p rescue --self-signed` it sends the recovery transaction directly to
# the glue, which is the escape hatch that works with the coordinator offline.
# ZECP2P_USER_PRIVATE_KEY=0x...

# The taker agent's key. Needs Base ETH for gas AND USDC for the stake, plus a
# logged-in Venmo account with real dollars in it. Only set this on the machine
# running the taker; the coordinator does not use it.
# TAKER_PRIVATE_KEY=0x...

# =============================================================================
# Contracts
# =============================================================================
# Deployed by scripts/deploy/01_deploy_contracts.sh. Leave blank on a first run;
# the script records it and prints the line to paste back here.
GLUE_CONTRACT_ADDRESS=

# USDC on Base mainnet.
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# zk-p2p EscrowV2: the escrow production makers deposit into. Paired with
# OrchestratorV3 below; the two must match or signalIntent reverts.
ZKP2P_ESCROW_ADDRESS=0x777777779d229cdF3110e9de47943791c26300Ef

# zk-p2p OrchestratorV3: where takers signal and fulfil intents.
ZKP2P_ORCHESTRATOR_ADDRESS=0x014025fDE093f8701d86e9f38e2C3a9b779cb5c7

# zk-p2p StakeVault. OrchestratorV3 routes signalIntent through a lifecycle hook
# that locks taker stake here, equal to the intent amount. A taker that has not
# staked gets InsufficientFreeStake.
STAKE_VAULT_ADDRESS=0x47c26258222e2f96424bD2B21bf173f0DA5034C7

# UnifiedPaymentVerifierV3. The EIP-712 verifyingContract the enclave signs
# against, and the contract that checks the signature during fulfillIntent.
ATTESTATION_VERIFIER_ADDRESS=0xC6F4a193576C60892a47e111Bb5706c30162502B

# =============================================================================
# External services
# =============================================================================

# Peer (zk-p2p) TEE attestation service. A Venmo payment proof is an EIP-712
# signature from an AWS Nitro enclave behind this URL. 00_preflight.sh verifies
# its attestation document to the AWS root before anything is sent to it.
#
# This has to be one of the three hosts the prover scripts hold a PCR8 pin for
# (production, staging, preprod); anything else is refused before the cookie is
# read. The pin is what makes the attestation mean anything: without one, the
# library compares the enclave measurement against a number the server itself
# supplied, so pointing this at another host would encrypt a live Venmo session
# cookie to a key that host holds. Adding a host means adding its PCR8 to
# TRUSTED_ENCLAVES in scripts/proof/prove_payment.mjs and check_enclave.mjs.
ATTESTATION_URL=https://attestation-service.zkp2p.xyz

# zk-p2p curator. Venmo usernames are registered here; the hashedOnchainId it
# returns is the payeeDetails that goes on chain. There is no local formula for
# that hash.
ZKP2P_API_URL=https://api.zkp2p.xyz

# NEAR Intents 1Click, the ZEC -> USDC inbound leg. Mainnet only; NEAR publishes
# no testnet and has said it does not plan to.
NEAR_API_URL=https://1click.chaindefuser.com

# =============================================================================
# Coordinator
# =============================================================================
COORDINATOR_HOST=127.0.0.1
COORDINATOR_PORT=3000
DATABASE_PATH=zecp2p.db

# Seconds between keeper ticks. Every tick costs RPC calls, not gas.
KEEPER_POLL_INTERVAL_SECONDS=15

# Seconds before the coordinator gives up on a session it is driving on Base.
# KEEPER_SESSION_TIMEOUT_SECONDS=3600

# Seconds before it gives up on a session still waiting for ZEC to arrive.
# Longer on purpose: 1Click keeps a deposit address live for about three days
# and refunds an under-deposit by that deadline, so a one-hour timeout would
# abandon a session whose refund is still in flight. 302400 = 3.5 days.
# KEEPER_NEAR_TIMEOUT_SECONDS=302400

# Blocks to scan back when there is no stored cursor yet.
# KEEPER_EVENT_LOOKBACK_BLOCKS=1000

# Seconds the coordinator gives a NEAR quote before it expires.
# NEAR_DEFAULT_TIMEOUT=600

# =============================================================================
# Taker agent (only on the machine running it)
# =============================================================================
# Largest intent the agent will take, in 6-decimal USDC units. Every intent
# locks this much USDC as stake AND costs the same amount in real dollars on
# Venmo, so this number is a real exposure limit, not a preference.
# TAKER_MAX_INTENT_AMOUNT=100000000

# Smallest intent worth the gas and the Venmo round trip.
# TAKER_MIN_INTENT_AMOUNT=1000000

# TAKER_POLL_INTERVAL_SECONDS=15
# TAKER_LOOKBACK_BLOCKS=5000

# Chrome started with --remote-debugging-port=9222, already logged into Venmo.
# The agent attaches to the open tab; it never handles Venmo credentials.
# VENMO_CDP_URL=http://127.0.0.1:9222
# VENMO_NOTE=thanks
# VENMO_TIMEOUT_SECONDS=120

# =============================================================================
# Optional
# =============================================================================

# Verifies the contract source on Basescan after a broadcast deploy.
# BASESCAN_API_KEY=

# Where a failed ZEC swap is refunded. Must be a TRANSPARENT address (t1 or t3):
# 1Click rejects unified and shielded addresses. Use one whose key you hold.
# ZEC_REFUND_ADDRESS=t1...

# Where 03_write_config.sh writes the generated configs.
# COORDINATOR_CONFIG_PATH=config.generated.toml
# TAKER_CONFIG_PATH=config.taker.generated.toml

# CLI target.
# ZECP2P_COORDINATOR_URL=http://localhost:3000
