# zecp2p Environment Variables
# Copy to .env and fill in your values

# =============================================================================
# STEP 1: Deploy GlueContract
# =============================================================================
# First, deploy the GlueContract to Base Sepolia (for testing) or Base mainnet:
#
#   cd contracts
#   forge script script/Deploy.s.sol:DeployOfframpGlue \
#     --rpc-url https://sepolia.base.org \
#     --broadcast
#
# After deployment, copy the contract address below.

# Your wallet's private key (hex with 0x prefix)
# This wallet will be the owner of the GlueContract and the coordinator
PRIVATE_KEY=0x...

# GlueContract address (set after deployment)
GLUE_CONTRACT_ADDRESS=0x...

# =============================================================================
# STEP 2: Set Keeper Address (Optional)
# =============================================================================
# By default, the owner is also the keeper. To use a separate keeper:
#
#   cd contracts
#   forge script script/Deploy.s.sol:SetKeeper \
#     --sig "run(address,address)" $GLUE_CONTRACT_ADDRESS $KEEPER_ADDRESS \
#     --rpc-url https://sepolia.base.org \
#     --broadcast

# =============================================================================
# STEP 3: Start Coordinator
# =============================================================================
# For testnet:
#   ZECP2P_CONFIG=config.testnet.toml cargo run --bin zecp2p-coordinator
#
# For mainnet:
#   cargo run --bin zecp2p-coordinator

# =============================================================================
# Optional Overrides
# =============================================================================

# Override RPC URLs (defaults in config.toml)
# BASE_RPC_URL=https://mainnet.base.org
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Override external APIs (defaults in config.toml). Point these at mock
# servers for dry runs.
# NEAR_API_URL=https://1click.chaindefuser.com
# ZKP2P_API_URL=https://api.zkp2p.xyz

# Basescan API key for contract verification
# BASESCAN_API_KEY=...

# CLI Configuration
# ZECP2P_COORDINATOR_URL=http://localhost:3000
# ZECP2P_CONFIG=config.toml
