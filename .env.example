# zecp2p Environment Variables
# Copy to .env and fill in your values

# Coordinator private key (for signing on-chain transactions)
# Required for the coordinator to create sessions and process offramps
COORDINATOR_PRIVATE_KEY=0x...

# GlueContract address (set after deployment)
GLUE_CONTRACT_ADDRESS=0x...

# Optional: Override RPC URLs (defaults in config.toml)
# BASE_RPC_URL=https://mainnet.base.org
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Basescan API key for contract verification
# BASESCAN_API_KEY=...

# CLI Configuration
# ZECP2P_COORDINATOR_URL=http://localhost:3000
# ZECP2P_CONFIG=config.toml

# Deployment (for forge script)
# PRIVATE_KEY=0x... (same as COORDINATOR_PRIVATE_KEY)
